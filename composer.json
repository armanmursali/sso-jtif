{
    "name": "jtif/sso-jtif",
    "description": "Package Client SSO mandiri dengan model tersentralisasi di dalam package untuk Laravel",
    "type": "library",
    "license": "MIT",
    "authors": [
        {
            "name": "Senior Software Developer & Team",
            "email": "developer@jtif.ac.id"
        }
    ],
    "require": {
        "php": "^8.1|^8.2|^8.3",
        "illuminate/support": "*",
        "illuminate/http": "*"
    },
    "autoload": {
        "psr-4": {
            "Jtif\\SsoJtif\\": "src/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Jtif\\SsoJtif\\SsoJtifServiceProvider"
            ]
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}